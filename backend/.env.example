PORT=4000
CORS_ORIGIN=*

# ZaloPay - mac dinh la sandbox demo credentials cong khai cua ZaloPay
# (https://github.com/zalopay-samples/quickstart-payment-gateway), doi sang
# app_id/key1/key2 that cua ban truoc khi len production.
ZALOPAY_APP_ID=15847
ZALOPAY_KEY1=0U93tRzdWEkMLVNYH90aBu5ca0Psql8T
ZALOPAY_KEY2=PurTcToVhvUt7vR2jO6He4lh3nfNEiks
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/
# Zalopay se goi vao day sau khi thanh toan thanh cong (can duong dan public,
# vi du ngrok, khi test tren dien thoai that/local)
ZALOPAY_CALLBACK_URL=http://localhost:4000/api/payments/zalopay/callback
# Trang mobile se duoc redirect ve sau khi thanh toan xong tren ZaloPay
ZALOPAY_REDIRECT_URL=http://localhost:3000/cart

# Private key rieng cua Mini App khi bat tinh nang Payment trong trang quan
# tri Mini App (Zalo Developers > Mini App cua ban > Payment) - KHAC voi
# key1/key2 cua ZaloPay o tren. Dung de ky "mac" cho zmp-sdk's createOrder().
# Bat buoc phai co gia tri that thi nut "Dat hang" (Checkout SDK) moi hoat dong.
ZMP_PAYMENT_PRIVATE_KEY=
