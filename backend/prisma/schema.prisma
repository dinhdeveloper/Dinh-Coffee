// User (điểm thưởng), Order (đơn hàng, tình trạng thanh toán) và Catalog
// (Category/Product) đều persist ở đây — catalog lấy thật từ DB, seed 1 lần
// bằng backend/prisma/seed.ts, không hard-code trong code nữa. Chạy đồng bộ
// schema này lên Postgres bằng: npx prisma db push

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id // id Zalo của người dùng
  name         String
  avatar       String   @default("")
  phone        String?
  points       Int      @default(0)
  firstLoginAt DateTime @default(now())
  lastLoginAt  DateTime @default(now())

  @@map("users")
}

model Order {
  id                 String    @id // appTransId gửi cho ZaloPay
  userId             String?
  subtotal           Int       @default(0) // tổng tiền hàng trước khi trừ điểm thưởng
  discount           Int       @default(0) // số tiền được giảm nhờ đổi điểm thưởng
  pointsUsed         Int       @default(0) // số điểm đã trừ của user cho đơn này — hoàn lại nếu đơn "failed"
  amount             Int // số tiền thực trả = subtotal - discount, gửi cho ZaloPay
  status             String    @default("pending") // "pending" | "paid" | "failed" | "cancelled"
  // Tình trạng chuẩn bị đơn sau khi đã "paid" — "confirmed" | "preparing" |
  // "delivering" | "completed", tự động tiến 1 bước mỗi phút (xem
  // advanceOrderStage trong orders.store.ts). null khi chưa thanh toán.
  stage              String?
  items              Json // OrderItem[]
  address            Json? // DeliveryAddress snapshot lúc đặt hàng
  checkoutSdkOrderId String?
  paidAt             DateTime? // mốc thời gian bắt đầu tính tiến độ stage ở trên
  createdAt          DateTime  @default(now())

  @@map("orders")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String? // null = thông báo chung, hiện cho mọi người dùng
  type      String // "order" | "promo" | "system"
  title     String
  message   String
  orderId   String? // đơn hàng liên quan (type "order") — dùng để nhấn "Xem đơn hàng" đi thẳng vào chi tiết đơn
  unread    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}

// Sổ địa chỉ giao hàng — gắn với userId (id Zalo) để đồng bộ giữa các thiết
// bị/lần cài lại app, thay vì chỉ lưu trên localStorage của từng máy.
model Address {
  id        String   @id @default(cuid())
  userId    String
  receiver  String
  phone     String
  detail    String
  note      String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("addresses")
}

// "Mỗi ngày 1 câu chuyện" — bài viết dài hiển thị ở trang /story, đổi mới
// theo publishedAt thay vì hard-code 1 đoạn văn cố định trong code.
model CafeStory {
  id          String   @id @default(cuid())
  title       String
  content     String
  publishedAt DateTime @default(now())

  @@map("cafe_stories")
}

// Story 24h kiểu Instagram (avatar bar ở trang chủ + thẻ "câu chuyện" nổi
// bật) — chỉ hiển thị trong vòng 24h kể từ khi tạo (lọc theo expiresAt ở
// tầng query), qua giờ đó tự động biến mất mà không cần dọn dữ liệu thủ công.
model StoreStory {
  id            String   @id @default(cuid())
  title         String
  location      String?
  rating        Float?
  price         String?
  avatar        String
  image         String
  thumbnail     String?
  productId     String?
  purchaseCount Int      @default(0) // số lượng đã mua, hiện dạng "+X lượt mua"
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  @@map("store_stories")
}

// Thẻ nổi bật (carousel lớn ở trang chủ) — độc lập với StoreStory: không hết
// hạn theo 24h, bật/tắt bằng isActive và sắp xếp bằng sortOrder.
model FeatureCard {
  id            String   @id @default(cuid())
  title         String
  location      String?
  rating        Float?
  price         String?
  avatar        String
  image         String
  thumbnail     String?
  productId     String?
  purchaseCount Int      @default(0)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  @@map("feature_cards")
}

// Đánh giá sản phẩm — 1 user có thể đánh giá nhiều sản phẩm khác nhau.
model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  userName  String
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("reviews")
}

// Đếm số lượng đã bán theo sản phẩm — cộng dồn mỗi khi 1 đơn hàng chứa sản
// phẩm đó được xác nhận "paid" (xem markOrderPaid trong orders.store.ts).
model ProductStat {
  productId     String @id
  purchaseCount Int    @default(0)

  @@map("product_stats")
}

// Danh mục món, lấy thật từ DB (không hard-code trong code nữa) — slug là
// khoá ổn định để tham chiếu ("hot-coffees"), name là tên tiếng Việt hiển
// thị trên UI, nameEn giữ tên gốc để tham khảo/đối chiếu nguồn.
model Category {
  id        String    @id @default(cuid())
  // Nullable dù về logic luôn có giá trị — cho phép "prisma db push" thêm cột
  // này an toàn vào bảng đã có sẵn dữ liệu cũ (không có default hợp lệ cho
  // cột unique khi nhiều dòng cùng lúc cần giá trị). Dòng cũ sẽ có slug NULL
  // cho tới khi seed lại.
  slug      String?   @unique
  name      String    @default("") // tên tiếng Việt hiển thị, vd "Cà phê nóng"
  nameEn    String    @default("") // tên gốc, vd "Hot Coffees"
  imageUrl  String    @default("")
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  products  Product[]

  @@map("categories")
}

// Catalog món, lấy thật từ DB — mỗi món có nhiều size với giá riêng
// (Tall/Grande/Venti...) thay vì 1 giá cộng phụ phí size cố định, và tuỳ
// chọn (milk, syrup, đá...) khai báo riêng theo từng món thay vì dùng chung
// 1 bộ size/đường/đá/topping cho mọi món như trước.
model Product {
  id            String    @id
  title         String // tên tiếng Việt hiển thị
  titleEn       String? // tên gốc, để tham khảo/đối chiếu nguồn
  price         Int // giá hiển thị mặc định (giá size đầu tiên) — dùng cho thẻ sản phẩm/tương thích ngược
  image         String
  categoryId    String?
  category      Category?  @relation(fields: [categoryId], references: [id])
  sizes         Json      @default("[]") // ProductSize[] — [{ code, label, volumeMl, price }]
  customizations Json      @default("[]") // ProductCustomization[] — [{ name, type: "single"|"multi"|"toggle", options?, priceDelta? }]
  nutrition     Json? // thông tin dinh dưỡng tự do theo từng món, hiển thị ở trang chi tiết
  allergens     String[]  @default([])
  tags          String[]  @default([])
  rating        Float     @default(0)
  reviewsCount  Int       @default(0) // số lượng đánh giá hiển thị trên thẻ sản phẩm — khác Review (chi tiết từng đánh giá)
  description   String
  isActive      Boolean   @default(true) // false = ẩn khỏi menu mà không cần xoá (đơn hàng cũ vẫn tham chiếu được id)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([categoryId])
  @@map("products")
}

// Banner tin tức/khuyến mãi hiển thị trên trang chủ (hiện đang hard-code 1
// banner "Cà phê kể chuyện mỗi ngày" trỏ /story trong index.tsx) — chuyển
// sang đây để đổi/thêm chương trình khuyến mãi mà không cần deploy lại app.
// linkType + linkValue quyết định bấm vào banner đi đâu, tuỳ theo loại:
// "story" -> CafeStory.id, "product" -> Product.id, "category" -> Category.id,
// "url" -> mở link ngoài, "none" -> banner chỉ để xem, không bấm được.
model Promotion {
  id            String    @id @default(cuid())
  title         String
  subtitle      String?
  content       String? // nội dung chi tiết hiển thị ở trang thông tin khuyến mãi khi bấm vào banner
  discountLabel String? // nhãn ưu đãi nổi bật, vd "-20%", "Giảm 10.000đ" — hiển thị to ở trang chi tiết
  code          String? // mã voucher để nhập khi thanh toán, null nếu ưu đãi tự động áp dụng
  image         String?
  linkType      String    @default("none") // "story" | "product" | "category" | "url" | "none"
  linkValue     String? // id tương ứng linkType, hoặc URL nếu linkType = "url"
  startAt       DateTime? // null = hiển thị ngay
  endAt         DateTime? // null = không hết hạn — lọc theo now() ở tầng query
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())

  @@map("promotions")
}
