{
  "name": "dinhtc-backend",
  "private": true,
  "version": "1.0.0",
  "description": "Backend API for BoomBerry mini app",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "postinstall": "prisma generate",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "prisma db push --skip-generate --accept-data-loss && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "tsc-alias": "^1.9.5",
    "typescript": "^5.5.3"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "tsx": "^4.16.2"
  }
}
